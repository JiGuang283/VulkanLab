# Shader binaries are generated per configuration in the build tree.
/shader/**/*.spv

# ---------- Runtime model assets ----------
# Keep required small sample assets trackable, but do not commit large local
# glTF samples by default. Add new assets here intentionally if a scene depends
# on them in a fresh checkout.
!models/viking_room.obj
*.glb
!models/SheenChair.glb
!models/third_party/kenney_furniture/*.glb
models/local/
models/sample/
models/main_sponza/
models/pkg_a_curtains/

# Environment source images are imported locally and baked into derived KTX2
# assets. Keep large HDR sources out of the repository by default.
assets/environments/**/*.hdr

# ---------- Runtime / scratch ----------
*.log
tem/
run_*.log
run_*.txt
derived_assets/
artifacts/
/external/tools/
/imgui.ini

# Local scene-authoring drafts are machine-specific. Promote scenes to the
# parent directory explicitly when they become project fixtures.
/assets/scenes/local/

# ---------- Local rendering references ----------
# The index and fetch script are versioned; downloaded third-party source,
# papers, and documentation snapshots remain local and reproducible.
/references/rendering_algorithms/downloads/

# ---------- OS files ----------
.DS_Store
Thumbs.db
