#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D sourceImage;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D destinationImage;

layout(push_constant) uniform BloomPushConstants {
    float threshold;
    float softKnee;
    float filterRadius;
    uint applyThreshold;
} push;

vec3 sampleSource(vec2 uv, vec2 offset)
{
    vec2 texelSize = 1.0 / vec2(textureSize(sourceImage, 0));
    return max(texture(sourceImage, uv + offset * texelSize).rgb, vec3(0.0));
}

vec3 downsample13Tap(vec2 uv)
{
    vec3 a = sampleSource(uv, vec2(-2.0,  2.0));
    vec3 b = sampleSource(uv, vec2( 0.0,  2.0));
    vec3 c = sampleSource(uv, vec2( 2.0,  2.0));
    vec3 d = sampleSource(uv, vec2(-2.0,  0.0));
    vec3 e = sampleSource(uv, vec2( 0.0,  0.0));
    vec3 f = sampleSource(uv, vec2( 2.0,  0.0));
    vec3 g = sampleSource(uv, vec2(-2.0, -2.0));
    vec3 h = sampleSource(uv, vec2( 0.0, -2.0));
    vec3 i = sampleSource(uv, vec2( 2.0, -2.0));
    vec3 j = sampleSource(uv, vec2(-1.0,  1.0));
    vec3 k = sampleSource(uv, vec2( 1.0,  1.0));
    vec3 l = sampleSource(uv, vec2(-1.0, -1.0));
    vec3 m = sampleSource(uv, vec2( 1.0, -1.0));

    return e * 0.125 +
           (a + c + g + i) * 0.03125 +
           (b + d + f + h) * 0.0625 +
           (j + k + l + m) * 0.125;
}

vec3 applySoftThreshold(vec3 color)
{
    float brightness = max(max(color.r, color.g), color.b);
    float knee = max(push.threshold * push.softKnee, 0.00001);
    float soft = clamp(brightness - push.threshold + knee,
                       0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee + 0.00001);
    float contribution =
        max(brightness - push.threshold, soft) /
        max(brightness, 0.00001);
    return color * contribution;
}

void main()
{
    ivec2 destinationSize = imageSize(destinationImage);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, destinationSize)))
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(destinationSize);
    vec3 color = downsample13Tap(uv);
    if (push.applyThreshold != 0u)
        color = applySoftThreshold(color);
    imageStore(destinationImage, pixel, vec4(color, 1.0));
}
