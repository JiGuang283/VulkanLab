#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D sourceImage;
layout(rgba16f, set = 0, binding = 1) uniform image2D destinationImage;

layout(push_constant) uniform BloomPushConstants {
    float threshold;
    float softKnee;
    float filterRadius;
    uint applyThreshold;
} push;

vec3 sampleSource(vec2 uv, vec2 offset)
{
    vec2 texelSize = 1.0 / vec2(textureSize(sourceImage, 0));
    return max(
        texture(sourceImage, uv + offset * texelSize * push.filterRadius).rgb,
        vec3(0.0));
}

vec3 upsampleTent(vec2 uv)
{
    vec3 color = vec3(0.0);
    color += sampleSource(uv, vec2(-1.0,  1.0));
    color += sampleSource(uv, vec2( 0.0,  1.0)) * 2.0;
    color += sampleSource(uv, vec2( 1.0,  1.0));
    color += sampleSource(uv, vec2(-1.0,  0.0)) * 2.0;
    color += sampleSource(uv, vec2( 0.0,  0.0)) * 4.0;
    color += sampleSource(uv, vec2( 1.0,  0.0)) * 2.0;
    color += sampleSource(uv, vec2(-1.0, -1.0));
    color += sampleSource(uv, vec2( 0.0, -1.0)) * 2.0;
    color += sampleSource(uv, vec2( 1.0, -1.0));
    return color * (1.0 / 16.0);
}

void main()
{
    ivec2 destinationSize = imageSize(destinationImage);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, destinationSize)))
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(destinationSize);
    vec3 existing = max(imageLoad(destinationImage, pixel).rgb, vec3(0.0));
    imageStore(destinationImage, pixel,
               vec4(existing + upsampleTent(uv), 1.0));
}
