#version 450

#extension GL_GOOGLE_include_directive : require
#include "include/global_frame.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D surfaceDepth;
layout(set = 1, binding = 1) uniform sampler2D surfaceNormalRoughness;
layout(set = 1, binding = 2) uniform sampler2D sourceReflection;
layout(set = 1, binding = 3, rgba16f) uniform writeonly image2D destination;

layout(push_constant) uniform SsrBlurPush {
    uvec4 dimensions; // full width, full height, axis, unused
} push;

vec3 octDecode(vec2 e) {
    vec2 v = e * 2.0 - 1.0;
    vec3 n = vec3(v, 1.0 - abs(v.x) - abs(v.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * sign(n.xy);
    return normalize(n);
}

ivec2 nearestSurfacePixel(ivec2 halfPixel)
{
    ivec2 fullSize = ivec2(push.dimensions.xy);
    ivec2 base = halfPixel * 2;
    ivec2 selected = min(base, fullSize - 1);
    float selectedDepth = 1.0;
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 candidate = min(base + ivec2(x, y), fullSize - 1);
            float depth = texelFetch(surfaceDepth, candidate, 0).r;
            if (depth < selectedDepth) {
                selectedDepth = depth;
                selected = candidate;
            }
        }
    }
    return selected;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destination);
    if (any(greaterThanEqual(pixel, size))) return;
    ivec2 fullPixel = nearestSurfacePixel(pixel);
    float centerDepth = texelFetch(surfaceDepth, fullPixel, 0).r;
    vec3 centerNormal = octDecode(texelFetch(surfaceNormalRoughness,
                                             fullPixel, 0).rg);
    ivec2 axis = push.dimensions.z == 0u ? ivec2(1, 0) : ivec2(0, 1);
    vec4 sum = vec4(0.0);
    float total = 0.0;
    for (int offset = -2; offset <= 2; ++offset) {
        ivec2 p = clamp(pixel + axis * offset, ivec2(0), size - 1);
        ivec2 fp = nearestSurfacePixel(p);
        float depth = texelFetch(surfaceDepth, fp, 0).r;
        vec3 normal = octDecode(texelFetch(surfaceNormalRoughness, fp, 0).rg);
        float spatial = offset == 0 ? 0.4 : (abs(offset) == 1 ? 0.24 : 0.06);
        float depthWeight = exp(-abs(depth - centerDepth) * 400.0);
        float normalWeight = pow(max(dot(centerNormal, normal), 0.0), 16.0);
        float weight = spatial * depthWeight * normalWeight;
        sum += texelFetch(sourceReflection, p, 0) * weight;
        total += weight;
    }
    imageStore(destination, pixel, sum / max(total, 1e-5));
}
