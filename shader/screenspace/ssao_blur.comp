#version 450

#extension GL_GOOGLE_include_directive : require
#include "include/global_frame.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D surfaceDepth;
layout(set = 1, binding = 1) uniform sampler2D surfaceNormalRoughness;
layout(set = 1, binding = 2) uniform sampler2D sourceAo;
layout(set = 1, binding = 3, r16f) uniform writeonly image2D destinationAo;

layout(push_constant) uniform SsaoPush {
    vec4 parameters;
    uvec4 dimensions;
} push;

vec3 octDecode(vec2 encoded)
{
    vec2 value = encoded * 2.0 - 1.0;
    vec3 normal = vec3(value, 1.0 - abs(value.x) - abs(value.y));
    if (normal.z < 0.0)
        normal.xy = (1.0 - abs(normal.yx)) * sign(normal.xy);
    return normalize(normal);
}

vec3 reconstructWorld(vec2 uv, float depth)
{
    vec4 world = ubo.inverseViewProjection *
                 vec4(uv * 2.0 - 1.0, depth, 1.0);
    return world.xyz / max(abs(world.w), 1e-6) * sign(world.w);
}

void halfSurface(ivec2 halfPixel, out float viewDepth, out vec3 normalVS)
{
    ivec2 fullSize = ivec2(push.dimensions.yz);
    ivec2 base = halfPixel * 2;
    float depth = 1.0;
    ivec2 selected = min(base, fullSize - ivec2(1));
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 candidate = min(base + ivec2(x, y),
                                  fullSize - ivec2(1));
            float candidateDepth = texelFetch(surfaceDepth, candidate, 0).r;
            if (candidateDepth < depth) {
                depth = candidateDepth;
                selected = candidate;
            }
        }
    }
    vec2 uv = (vec2(selected) + 0.5) / vec2(fullSize);
    viewDepth = depth >= 1.0 ? -1e20 :
        (ubo.view * vec4(reconstructWorld(uv, depth), 1.0)).z;
    vec3 normalWS = octDecode(texelFetch(surfaceNormalRoughness,
                                         selected, 0).rg);
    normalVS = normalize(mat3(ubo.view) * normalWS);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(destinationAo);
    if (any(greaterThanEqual(pixel, outputSize)))
        return;

    float centerDepth;
    vec3 centerNormal;
    halfSurface(pixel, centerDepth, centerNormal);
    ivec2 axis = push.dimensions.w == 0u ? ivec2(1, 0) : ivec2(0, 1);
    float weighted = 0.0;
    float totalWeight = 0.0;
    const float spatial[3] = float[3](1.0, 0.75, 0.375);
    for (int offset = -2; offset <= 2; ++offset) {
        ivec2 samplePixel = clamp(pixel + axis * offset,
                                  ivec2(0), outputSize - ivec2(1));
        float sampleDepth;
        vec3 sampleNormal;
        halfSurface(samplePixel, sampleDepth, sampleNormal);
        float depthWeight = exp(-abs(centerDepth - sampleDepth) * 12.0);
        float normalWeight = pow(max(dot(centerNormal, sampleNormal), 0.0), 8.0);
        float weight = spatial[abs(offset)] * depthWeight * normalWeight;
        weighted += texelFetch(sourceAo, samplePixel, 0).r * weight;
        totalWeight += weight;
    }
    imageStore(destinationAo, pixel,
               vec4(weighted / max(totalWeight, 1e-5)));
}
