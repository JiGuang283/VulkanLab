#version 450

#extension GL_GOOGLE_include_directive : require
#include "include/global_frame.glsl"
#include "include/screen_temporal.glsl"
#include "include/depth_hierarchy.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D surfaceDepth;
layout(set = 1, binding = 1) uniform sampler2D surfaceNormalRoughness;
layout(set = 1, binding = 2) uniform sampler2D nearestDepthPyramid;
layout(set = 1, binding = 3) uniform sampler2D sceneColorPyramid;
layout(set = 1, binding = 4, rgba16f) uniform writeonly image2D destination;

layout(push_constant) uniform SsrTracePush {
    vec4 parameters; // max distance, thickness, max roughness, intensity
    uvec4 dimensions; // max steps, refinement steps, full width, full height
    vec4 sampling; // depth max mip, color max mip, frame phase, unused
} push;

vec3 octDecode(vec2 encoded)
{
    vec2 value = encoded * 2.0 - 1.0;
    vec3 normal = vec3(value, 1.0 - abs(value.x) - abs(value.y));
    if (normal.z < 0.0)
        normal.xy = (1.0 - abs(normal.yx)) * sign(normal.xy);
    return normalize(normal);
}

vec3 reconstructWorld(vec2 uv, float depth)
{
    vec4 world = ubo.inverseViewProjection *
                 vec4(uv * 2.0 - 1.0, depth, 1.0);
    return world.xyz / max(abs(world.w), 1e-6) * sign(world.w);
}

void nearestSurface(ivec2 halfPixel, out ivec2 fullPixel, out float depth)
{
    ivec2 fullSize = ivec2(push.dimensions.zw);
    ivec2 base = halfPixel * 2;
    fullPixel = min(base, fullSize - ivec2(1));
    depth = 1.0;
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 candidate = min(base + ivec2(x, y), fullSize - ivec2(1));
            float candidateDepth = texelFetch(surfaceDepth, candidate, 0).r;
            if (candidateDepth < depth) {
                depth = candidateDepth;
                fullPixel = candidate;
            }
        }
    }
}

bool projectWorld(vec3 position, out vec2 uv, out float depth)
{
    vec4 clip = ubo.proj * ubo.view * vec4(position, 1.0);
    if (clip.w <= 1e-5)
        return false;
    vec3 ndc = clip.xyz / clip.w;
    uv = ndc.xy * 0.5 + 0.5;
    depth = ndc.z;
    return depth > 0.0 && depth < 1.0 && screenUvInBounds(uv);
}

uint pcgHash(uint value)
{
    uint state = value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomPhase(ivec2 pixel, ivec2 size, uint framePhase)
{
    uint seed = uint(pixel.x) + uint(pixel.y) * uint(size.x);
    seed ^= framePhase * 0x9e3779b9u;
    return float(pcgHash(seed) & 0x00ffffffu) / 16777216.0;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(destination);
    if (any(greaterThanEqual(pixel, outputSize)))
        return;

    ivec2 fullPixel;
    float centerDepth;
    nearestSurface(pixel, fullPixel, centerDepth);
    if (centerDepth >= 1.0) {
        imageStore(destination, pixel, vec4(0.0));
        return;
    }
    vec4 packed = texelFetch(surfaceNormalRoughness, fullPixel, 0);
    vec3 normalWS = octDecode(packed.rg);
    float roughness = packed.b;
    if (roughness > push.parameters.z) {
        imageStore(destination, pixel, vec4(0.0));
        return;
    }

    vec2 fullSize = vec2(push.dimensions.zw);
    vec2 centerUv = (vec2(fullPixel) + 0.5) / fullSize;
    vec3 surfacePosition = reconstructWorld(centerUv, centerDepth);
    vec3 viewDirection = normalize(surfacePosition - ubo.cameraPosWS.xyz);
    vec3 rayDirection = normalize(reflect(viewDirection, normalWS));
    if (dot(rayDirection, normalWS) <= 0.0) {
        imageStore(destination, pixel, vec4(0.0));
        return;
    }

    uint steps = max(push.dimensions.x, 1u);
    float maxDistance = max(push.parameters.x, 0.01);
    float thickness = max(push.parameters.y, 1.0e-4);
    float stride = maxDistance / float(steps);
    float phase = randomPhase(pixel, outputSize, uint(push.sampling.z));
    vec3 origin = surfacePosition + normalWS * max(thickness, 0.01);
    float previousT = max(stride * (0.25 + phase), 0.02);
    float previousSeparation = 0.0;
    bool previousValid = false;
    vec2 hitUv = vec2(0.0);
    float hitT = 0.0;
    bool hit = false;

    for (uint step = 0u; step < 96u; ++step) {
        if (step >= steps)
            break;
        float t = stride * (float(step) + 0.5 + phase);
        vec3 rayPosition = origin + rayDirection * t;
        vec2 uv;
        float rayDepth;
        if (!projectWorld(rayPosition, uv, rayDepth))
            break;
        float footprint = max(t / maxDistance * 16.0, 1.0);
        float mip = clamp(floor(log2(footprint)), 0.0, push.sampling.x);
        float sceneDepth = vklSampleNearestDepth(
            nearestDepthPyramid, uv, mip);
        if (sceneDepth >= 1.0) {
            previousValid = false;
            continue;
        }
        vec3 scenePosition = reconstructWorld(uv, sceneDepth);
        vec3 rayVS = (ubo.view * vec4(rayPosition, 1.0)).xyz;
        vec3 sceneVS = (ubo.view * vec4(scenePosition, 1.0)).xyz;
        float separation = rayVS.z - sceneVS.z;
        if (separation <= 0.0) {
            if (previousValid && previousSeparation > 0.0) {
                float frontT = previousT;
                float backT = t;
                vec2 refinedUv = uv;
                uint refinements = min(push.dimensions.y, 8u);
                for (uint refinement = 0u; refinement < 8u; ++refinement) {
                    if (refinement >= refinements)
                        break;
                    float candidateT = 0.5 * (frontT + backT);
                    vec3 candidatePosition =
                        origin + rayDirection * candidateT;
                    vec2 candidateUv;
                    float candidateDepth;
                    if (!projectWorld(candidatePosition, candidateUv,
                                      candidateDepth)) {
                        backT = candidateT;
                        continue;
                    }
                    float candidateSceneDepth = vklSampleNearestDepth(
                        nearestDepthPyramid, candidateUv, 0.0);
                    if (candidateSceneDepth >= 1.0) {
                        frontT = candidateT;
                        continue;
                    }
                    vec3 candidateScene =
                        reconstructWorld(candidateUv, candidateSceneDepth);
                    float candidateSeparation =
                        (ubo.view * vec4(candidatePosition, 1.0)).z -
                        (ubo.view * vec4(candidateScene, 1.0)).z;
                    if (candidateSeparation > 0.0) {
                        frontT = candidateT;
                    } else {
                        backT = candidateT;
                        refinedUv = candidateUv;
                    }
                }
                hit = true;
                hitUv = refinedUv;
                hitT = backT;
                break;
            }
            if (abs(separation) <= thickness) {
                hit = true;
                hitUv = uv;
                hitT = t;
                break;
            }
        }
        previousT = t;
        previousSeparation = separation;
        previousValid = separation > 0.0;
    }

    if (!hit) {
        imageStore(destination, pixel, vec4(0.0));
        return;
    }

    float edge = min(min(hitUv.x, hitUv.y),
                     min(1.0 - hitUv.x, 1.0 - hitUv.y));
    float edgeFade = smoothstep(0.0, 0.08, edge);
    float distanceFade = 1.0 - clamp(hitT / maxDistance, 0.0, 1.0);
    float roughnessFade = 1.0 - smoothstep(
        push.parameters.z * 0.7, push.parameters.z, roughness);
    float confidence = edgeFade * distanceFade * roughnessFade;
    float colorMip = roughness * push.sampling.y;
    vec3 radiance = textureLod(sceneColorPyramid, hitUv, colorMip).rgb *
                    push.parameters.w;
    imageStore(destination, pixel, vec4(radiance, confidence));
}
