#version 450

#extension GL_GOOGLE_include_directive : require
#include "include/screen_temporal.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D currentAo;
layout(set = 0, binding = 1) uniform sampler2D currentDepth;
layout(set = 0, binding = 2) uniform sampler2D currentNormalRoughness;
layout(set = 0, binding = 3) uniform sampler2D currentMotion;
layout(set = 0, binding = 4) uniform sampler2D previousDepth;
layout(set = 0, binding = 5) uniform sampler2D previousNormalRoughness;
layout(set = 0, binding = 6) uniform sampler2D previousHistory;
layout(set = 0, binding = 7, r16f) uniform writeonly image2D destinationHistory;
layout(set = 0, binding = 8, r16f) uniform writeonly image2D destinationDebug;

layout(push_constant) uniform GtaoTemporalPush {
    vec4 parameters; // history weight, depth threshold, normal threshold, unused
    uvec4 dimensions; // full width, full height, history valid, debug kind
} push;

vec3 octDecode(vec2 encoded)
{
    vec2 value = encoded * 2.0 - 1.0;
    vec3 normal = vec3(value, 1.0 - abs(value.x) - abs(value.y));
    if (normal.z < 0.0)
        normal.xy = (1.0 - abs(normal.yx)) * sign(normal.xy);
    return normalize(normal);
}

void nearestSurface(ivec2 halfPixel, out ivec2 fullPixel, out float depth)
{
    ivec2 fullSize = ivec2(push.dimensions.xy);
    ivec2 base = halfPixel * 2;
    fullPixel = min(base, fullSize - ivec2(1));
    depth = 1.0;
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 candidate = min(base + ivec2(x, y),
                                  fullSize - ivec2(1));
            float candidateDepth = texelFetch(currentDepth, candidate, 0).r;
            if (candidateDepth < depth) {
                depth = candidateDepth;
                fullPixel = candidate;
            }
        }
    }
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(destinationHistory);
    if (any(greaterThanEqual(pixel, outputSize)))
        return;

    float raw = texelFetch(currentAo, pixel, 0).r;
    ivec2 fullPixel;
    float depth;
    nearestSurface(pixel, fullPixel, depth);
    vec2 fullSize = vec2(push.dimensions.xy);
    vec2 uv = (vec2(fullPixel) + 0.5) / fullSize;
    vec2 motion = texelFetch(currentMotion, fullPixel, 0).xy;
    vec2 previousUv = uv + motion;

    bool accepted = push.dimensions.z != 0u && depth < 1.0 &&
                    screenUvInBounds(previousUv);
    float history = raw;
    if (accepted) {
        float oldDepth = texture(previousDepth, previousUv).r;
        vec3 normal = octDecode(texelFetch(currentNormalRoughness,
                                           fullPixel, 0).rg);
        vec3 oldNormal = octDecode(texture(previousNormalRoughness,
                                           previousUv).rg);
        float depthTolerance = max(push.parameters.y,
                                   push.parameters.y * max(depth, 0.1));
        accepted = oldDepth < 1.0 &&
                   abs(oldDepth - depth) <= depthTolerance &&
                   dot(normal, oldNormal) >= push.parameters.z;
        if (accepted)
            history = texture(previousHistory, previousUv).r;
    }

    float neighborhoodMin = raw;
    float neighborhoodMax = raw;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 samplePixel = clamp(pixel + ivec2(x, y), ivec2(0),
                                      outputSize - ivec2(1));
            float sampleAo = texelFetch(currentAo, samplePixel, 0).r;
            neighborhoodMin = min(neighborhoodMin, sampleAo);
            neighborhoodMax = max(neighborhoodMax, sampleAo);
        }
    }
    history = clamp(history, neighborhoodMin, neighborhoodMax);
    float weight = accepted ? clamp(push.parameters.x, 0.0, 0.98) : 0.0;
    float resolved = mix(raw, history, weight);
    imageStore(destinationHistory, pixel, vec4(resolved));
    float debugValue = push.dimensions.w == 0u ? (accepted ? 0.0 : 1.0)
                                               : weight;
    imageStore(destinationDebug, pixel, vec4(debugValue));
}
