#version 450

#extension GL_GOOGLE_include_directive : require
#include "include/global_frame.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D surfaceDepth;
layout(set = 1, binding = 1) uniform sampler2D surfaceNormalRoughness;
layout(set = 1, binding = 2, r32f) uniform writeonly image2D cacaoDepth;
layout(set = 1, binding = 3, rgba8) uniform writeonly image2D viewNormals;

vec3 octDecode(vec2 encoded)
{
    vec2 value = encoded * 2.0 - 1.0;
    vec3 normal = vec3(value, 1.0 - abs(value.x) - abs(value.y));
    if (normal.z < 0.0)
        normal.xy = (1.0 - abs(normal.yx)) * sign(normal.xy);
    return normalize(normal);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(viewNormals);
    if (any(greaterThanEqual(pixel, extent)))
        return;

    vec3 normalWS = octDecode(texelFetch(surfaceNormalRoughness, pixel, 0).rg);
    vec3 normalVS = normalize(mat3(ubo.view) * normalWS);
    imageStore(cacaoDepth, pixel,
               vec4(texelFetch(surfaceDepth, pixel, 0).r, 0.0, 0.0, 0.0));
    imageStore(viewNormals, pixel, vec4(normalVS * 0.5 + 0.5, 1.0));
}
