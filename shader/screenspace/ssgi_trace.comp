#version 450

#extension GL_GOOGLE_include_directive : require
#include "include/global_frame.glsl"
#include "include/screen_temporal.glsl"
#include "include/depth_hierarchy.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D surfaceDepth;
layout(set = 1, binding = 1) uniform sampler2D surfaceNormalRoughness;
layout(set = 1, binding = 2) uniform sampler2D surfaceAlbedoMetallic;
layout(set = 1, binding = 3) uniform sampler2D nearestDepthPyramid;
layout(set = 1, binding = 4) uniform sampler2D sceneColorPyramid;
layout(set = 1, binding = 5, rgba16f) uniform writeonly image2D destination;

layout(push_constant) uniform SsgiTracePush {
    vec4 parameters; // distance, thickness, intensity, radiance clamp
    uvec4 dimensions; // rays, steps, full width, full height
    vec4 sampling; // depth max mip, color max mip, frame phase, unused
} push;

const float PI = 3.14159265359;

vec3 octDecode(vec2 encoded)
{
    vec2 value = encoded * 2.0 - 1.0;
    vec3 normal = vec3(value, 1.0 - abs(value.x) - abs(value.y));
    if (normal.z < 0.0)
        normal.xy = (1.0 - abs(normal.yx)) * sign(normal.xy);
    return normalize(normal);
}

vec3 reconstructWorld(vec2 uv, float depth)
{
    vec4 world = ubo.inverseViewProjection *
                 vec4(uv * 2.0 - 1.0, depth, 1.0);
    return world.xyz / max(abs(world.w), 1e-6) * sign(world.w);
}

bool projectWorld(vec3 position, out vec2 uv)
{
    vec4 clip = ubo.proj * ubo.view * vec4(position, 1.0);
    if (clip.w <= 1e-5)
        return false;
    vec3 ndc = clip.xyz / clip.w;
    uv = ndc.xy * 0.5 + 0.5;
    return ndc.z > 0.0 && ndc.z < 1.0 && screenUvInBounds(uv);
}

void nearestSurface(ivec2 halfPixel, out ivec2 fullPixel, out float depth)
{
    ivec2 fullSize = ivec2(push.dimensions.zw);
    ivec2 base = halfPixel * 2;
    fullPixel = min(base, fullSize - ivec2(1));
    depth = 1.0;
    for (int y = 0; y < 2; ++y) for (int x = 0; x < 2; ++x) {
        ivec2 candidate = min(base + ivec2(x, y), fullSize - ivec2(1));
        float candidateDepth = texelFetch(surfaceDepth, candidate, 0).r;
        if (candidateDepth < depth) {
            depth = candidateDepth;
            fullPixel = candidate;
        }
    }
}

float hash12(vec2 p)
{
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec3 cosineDirection(vec2 xi, vec3 n)
{
    float radius = sqrt(xi.x);
    float phi = 2.0 * PI * xi.y;
    vec3 local = vec3(radius * cos(phi), radius * sin(phi),
                      sqrt(max(1.0 - xi.x, 0.0)));
    vec3 helper = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0)
                                   : vec3(0.0, 1.0, 0.0);
    vec3 tangent = normalize(cross(helper, n));
    vec3 bitangent = cross(n, tangent);
    return normalize(tangent * local.x + bitangent * local.y + n * local.z);
}

bool traceRay(vec3 origin, vec3 direction, float phase,
              out vec2 hitUv, out float hitDistance)
{
    uint steps = max(push.dimensions.y, 1u);
    float maxDistance = max(push.parameters.x, 0.01);
    float stride = maxDistance / float(steps);
    for (uint step = 0u; step < 48u; ++step) {
        if (step >= steps)
            break;
        float distanceAlongRay = stride * (float(step) + 0.75 + phase);
        vec3 rayPosition = origin + direction * distanceAlongRay;
        vec2 uv;
        if (!projectWorld(rayPosition, uv))
            break;
        float footprint = max(distanceAlongRay / maxDistance * 12.0, 1.0);
        float mip = clamp(floor(log2(footprint)), 0.0, push.sampling.x);
        float sceneDepth = vklSampleNearestDepth(
            nearestDepthPyramid, uv, mip);
        if (sceneDepth >= 1.0)
            continue;
        vec3 scenePosition = reconstructWorld(uv, sceneDepth);
        vec3 rayVS = (ubo.view * vec4(rayPosition, 1.0)).xyz;
        vec3 sceneVS = (ubo.view * vec4(scenePosition, 1.0)).xyz;
        float separation = rayVS.z - sceneVS.z;
        if (separation <= 0.0 && abs(separation) <= push.parameters.y) {
            hitUv = uv;
            hitDistance = distanceAlongRay;
            return true;
        }
    }
    return false;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(destination);
    if (any(greaterThanEqual(pixel, outputSize)))
        return;

    ivec2 fullPixel;
    float depth;
    nearestSurface(pixel, fullPixel, depth);
    if (depth >= 1.0) {
        imageStore(destination, pixel, vec4(0.0));
        return;
    }

    vec4 packedNormal = texelFetch(surfaceNormalRoughness, fullPixel, 0);
    vec4 surface = texelFetch(surfaceAlbedoMetallic, fullPixel, 0);
    vec3 normal = octDecode(packedNormal.rg);
    vec3 diffuseResponse = surface.rgb * (1.0 - surface.a);
    vec2 uv = (vec2(fullPixel) + 0.5) / vec2(push.dimensions.zw);
    vec3 origin = reconstructWorld(uv, depth) + normal * 0.02;

    uint rayCount = max(push.dimensions.x, 1u);
    float rotation = hash12(vec2(pixel) + push.sampling.z * 17.0);
    vec3 radiance = vec3(0.0);
    float confidence = 0.0;
    uint hits = 0u;
    for (uint ray = 0u; ray < 8u; ++ray) {
        if (ray >= rayCount)
            break;
        vec2 xi = vec2((float(ray) + 0.5) / float(rayCount),
                       fract(rotation + float(ray) * 0.61803398875));
        vec3 direction = cosineDirection(xi, normal);
        vec2 hitUv;
        float hitDistance;
        float rayPhase = fract(rotation + float(ray) * 0.754877666);
        if (!traceRay(origin, direction, rayPhase, hitUv, hitDistance))
            continue;
        float edge = min(min(hitUv.x, hitUv.y),
                         min(1.0 - hitUv.x, 1.0 - hitUv.y));
        float rayConfidence = smoothstep(0.0, 0.06, edge) *
            (1.0 - clamp(hitDistance / push.parameters.x, 0.0, 1.0));
        float lod = clamp(log2(max(hitDistance, 1.0)) * 0.5,
                          0.0, push.sampling.y);
        vec3 sampleRadiance = textureLod(sceneColorPyramid, hitUv, lod).rgb;
        radiance += min(sampleRadiance, vec3(push.parameters.w));
        confidence += rayConfidence;
        ++hits;
    }

    if (hits == 0u) {
        imageStore(destination, pixel, vec4(0.0));
        return;
    }
    radiance = radiance / float(hits) * diffuseResponse * push.parameters.z;
    confidence = confidence / float(rayCount);
    imageStore(destination, pixel, vec4(radiance, confidence));
}
