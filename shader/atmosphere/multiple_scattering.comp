#version 450

#extension GL_GOOGLE_include_directive : require
#define ATMOSPHERE_SET 0
#define ATMOSPHERE_NO_GLOBAL_FRAME
#include "include/atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba16f, set = 1, binding = 0) uniform writeonly image2D destinationImage;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destinationImage);
    if (any(greaterThanEqual(pixel, size)))
        return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float radius = mix(atmosphereBottomRadius(), atmosphereTopRadius(), uv.y);
    float mu = uv.x * 2.0 - 1.0;
    vec3 position = atmospherePlanetCenter() + vec3(0.0, 0.0, radius);
    vec3 direction = normalize(vec3(sqrt(max(1.0 - mu * mu, 0.0)), 0.0, mu));
    vec3 transmittance = sampleAtmosphereTransmittance(position, direction);
    vec3 scattering = atmosphere.rayleighScatteringOzoneHalfWidth.rgb +
                      vec3(atmosphere.mieScatteringExtinction.x);
    vec3 extinction = atmosphere.rayleighScatteringOzoneHalfWidth.rgb +
                      vec3(atmosphere.mieScatteringExtinction.y) +
                      atmosphere.ozoneAbsorptionAerialStart.rgb;
    vec3 albedo = scattering / max(extinction, vec3(1e-4));
    vec3 multiple = (vec3(1.0) - transmittance) * albedo *
                    (0.20 + 0.15 * atmosphere.groundAlbedoDistanceScale.rgb);
    imageStore(destinationImage, pixel, vec4(max(multiple, vec3(0.0)), 1.0));
}
