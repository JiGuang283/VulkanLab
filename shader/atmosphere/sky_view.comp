#version 450

#extension GL_GOOGLE_include_directive : require
#define ATMOSPHERE_SET 0
#define ATMOSPHERE_NO_GLOBAL_FRAME
#include "include/atmosphere_scattering.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba16f, set = 1, binding = 0) uniform writeonly image2D destinationImage;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destinationImage);
    if (any(greaterThanEqual(pixel, size)))
        return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 direction = atmosphereUvDirection(uv);
    vec3 transmittance;
    vec3 radiance = integrateAtmosphere(vec3(0.0), direction, 200.0, 32,
                                        transmittance);
    imageStore(destinationImage, pixel, vec4(radiance, 1.0));
}
