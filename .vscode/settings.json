{
    "cSpell.words": [
        "blit",
        "commandpool",
        "msaa",
        "nullptr",
        "renderpass",
        "stbi",
        "Subpasses",
        "tinyobj"
    ],
    "C_Cpp.intelliSenseEngine": "Default",
